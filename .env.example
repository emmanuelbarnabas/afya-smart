# Environment variables za Afya Smart
# Copy this file to .env and fill in real values

# --- App ---
ENVIRONMENT=development

# --- Database ---
# Dev (bila docker): SQLite
DATABASE_URL=sqlite:///./afyasmart.db
# Prod (postgreSQL, mfano wa docker-compose ya infra/):
# DATABASE_URL=postgresql+psycopg2://afya:afya@localhost:5432/afyasmart
POSTGRES_USER=afya
POSTGRES_PASSWORD=afya
POSTGRES_DB=afyasmart

# --- Africa's Talking (USSD & SMS) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_PHONE_NUMBER=
USSD_SERVICE_CODE=*384*123#

# --- ML model paths ---
TRIAGE_MODEL_PATH=ml/artifacts/triage_model.joblib
DEMAND_MODEL_PATH=ml/artifacts/demand_forecast.joblib
